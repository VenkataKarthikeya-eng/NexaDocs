# ==============================================================================
# NexaDocs Backend Environment Variables (.env)
# ==============================================================================

# Application & Environment
PROJECT_NAME=NexaDocs
ENVIRONMENT=production
DEBUG=False

# Neon PostgreSQL Database Connection
# Supports postgresql+psycopg:// (psycopg 3), postgresql+psycopg2://, or postgresql:// with ?sslmode=require
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & JWT Secrets (Minimum 32 characters)
SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_SECRET=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-lite-latest

# Remote Vector Embeddings (Gemini Production Path, <80MB RAM)
# Options: GEMINI (production remote) or LOCAL (SentenceTransformers development)
EMBEDDING_PROVIDER=GEMINI
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# Vector Storage Engine
# Options: POSTGRES (persistent in Neon / pgvector) or FAISS (local dev)
VECTOR_STORAGE_TYPE=POSTGRES

# Object Storage Configuration (Neon S3-Compatible Storage vs Local Disk)
# Options: S3 or LOCAL
STORAGE_TYPE=S3
S3_BUCKET_NAME=nexadocs-files
S3_REGION=us-east-2
S3_ENDPOINT_URL=https://YOUR_NEON_REGION.storage.neon.tech
S3_ACCESS_KEY_ID=YOUR_NEON_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_NEON_S3_SECRET_KEY
S3_PRESIGNED_EXPIRATION_SECONDS=3600

# Local Storage Paths (Used when STORAGE_TYPE=LOCAL)
UPLOAD_DIR=uploads
FAISS_INDEX_PATH=data/vector_stores

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["https://nexa-docs.vercel.app","http://localhost:5173"]
