# NexaDocs Environment Variables Template

# 1. Database Configuration
# Leave blank for local development SQLite (sqlite:///./nexadocs.db)
# PostgreSQL Production (Render Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 2. JWT Security
# Generate a secure 64-character secret (e.g. openssl rand -hex 32)
JWT_SECRET=

# 3. Google Gemini API Configuration (for AI Answer Generation & Insights)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 4. Storage Configuration (LOCAL, S3, CLOUDINARY)
STORAGE_PROVIDER=LOCAL
AWS_S3_BUCKET=
AWS_REGION=us-east-1
CLOUDINARY_URL=
